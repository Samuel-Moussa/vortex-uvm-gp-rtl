typedef RISCV_instruction #(ILEN, XLEN, FLEN, VLEN, NHART, RETIRE) ins_rv32zicsr_t;


covergroup rv32zicsr_csrrc_cg with function sample(ins_rv32zicsr_t ins);
    option.per_instance = 1; 
    option.comment = "CSR Read Clear";
`ifdef COVER_ILLEGAL_INST_CSRRC
    cp_illegal_inst : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_AFTER, "mcause", "") == `MCAUSE_ILLEGAL_INST  iff (ins.trap == 1 )  {
        option.comment = "If instruction is not implemented in this configuration, check that exception is being hit";
    }
`else
`ifdef COVER_TYPE_ASM_COUNT
    cp_asm_count : coverpoint ins.ins_str == "csrrc"  iff (ins.trap == 0 )  {
        option.comment = "Number of times instruction executed";
        bins count[]  = {1};
    }
`endif  // COVER_TYPE_ASM_COUNT

`ifdef COVER_TYPE_REG_ASSIGN
    cp_rd_reg_assign : coverpoint ins.get_gpr_reg(ins.current.rd)  iff (ins.trap == 0 )  {
        option.comment = "All legal register assignments";
    }
    cp_rs1_reg_assign : coverpoint ins.get_gpr_reg(ins.current.rs1)  iff (ins.trap == 0 )  {
        option.comment = "All legal register assignments";
    }
`endif  // COVER_TYPE_REG_ASSIGN

`ifdef COVER_TYPE_REG_COMPARE
    cp_rd_rs1_compare : coverpoint ins.current.rd == ins.current.rs1  iff (ins.trap == 0 )  {
        option.comment = "Register assignments using same register";
    }
    cr_rd_rs1_compare : cross cp_rd_rs1_compare, cp_rd_reg_assign iff (ins.trap == 0 )  {
        option.comment = "Cross coverage to check for each register";
        ignore_bins no_overlap = binsof(cp_rd_rs1_compare) intersect {0};
    }
`endif  // COVER_TYPE_REG_COMPARE

`ifdef COVER_TYPE_REG_VALUE_SIGN
    cp_rd_sign : coverpoint int32_t'(ins.current.rd_val)  iff (ins.trap == 0 )  {
        option.comment = "Check if register value is pos/neg/zero";
        bins neg  = {[$:-1]};
        bins pos  = {[1:$]};
        bins zero = {0};
    }
    cp_rs1_sign : coverpoint int32_t'(ins.current.rs1_val)  iff (ins.trap == 0 )  {
        option.comment = "Check if register value is pos/neg/zero";
        bins neg  = {[$:-1]};
        bins pos  = {[1:$]};
        bins zero = {0};
    }
`endif  // COVER_TYPE_REG_VALUE_SIGN

`ifdef COVER_TYPE_IMM_VALUE
    cp_csr_value : coverpoint int'(ins.current.imm)  iff (ins.trap == 0 )  {
        option.comment = "Check values for immediate";
        bins neg  = {[$:-1]};
        bins pos  = {[1:$]};
        bins zero = {0};
    }
`endif  // COVER_TYPE_IMM_VALUE

`ifdef COVER_TYPE_REG_VALUE
    cp_rd_value : coverpoint uint32_t'(ins.current.rd_val)  iff (ins.trap == 0 )  {
        option.comment = "Check significant values for each register";
        bins zeros = {0};
        bins min   = {32'b10000000000000000000000000000000};
        bins max   = {32'b01111111111111111111111111111111};
        bins ones  = {32'b11111111111111111111111111111111};
        bins one   = {32'b00000000000000000000000000000001};
        bins minp1 = {32'b10000000000000000000000000000001};
    }
    cp_rs1_value : coverpoint uint32_t'(ins.current.rs1_val)  iff (ins.trap == 0 )  {
        option.comment = "Check significant values for each register";
        bins zeros = {0};
        bins min   = {32'b10000000000000000000000000000000};
        bins max   = {32'b01111111111111111111111111111111};
        bins ones  = {32'b11111111111111111111111111111111};
        bins one   = {32'b00000000000000000000000000000001};
        bins minp1 = {32'b10000000000000000000000000000001};
    }
`endif  // COVER_TYPE_REG_VALUE

`ifdef COVER_TYPE_REG_VALUE_TOGGLE
    cp_rd_toggle : coverpoint uint32_t'(ins.current.rd_val)  iff (ins.trap == 0 )  {
        option.comment = "Check for each bit toggling in each register";
        `RV32_BIT_TOGGLE_VALS
    }
    cp_rs1_toggle : coverpoint uint32_t'(ins.current.rs1_val)  iff (ins.trap == 0 )  {
        option.comment = "Check for each bit toggling in each register";
        `RV32_BIT_TOGGLE_VALS
    }
`endif  // COVER_TYPE_REG_VALUE_TOGGLE

`ifdef COVER_TYPE_REG_HAZARD
    cp_reg_hazards : coverpoint check_gpr_hazards(ins.hart, ins.issue)  iff (ins.trap == 0 )  {
        option.comment = "Check for possible register hazards";
    }
`endif  // COVER_TYPE_REG_HAZARD

`endif  // !COVER_ILLEGAL_INST_CSRRC
endgroup

