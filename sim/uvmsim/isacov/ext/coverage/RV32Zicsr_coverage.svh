function void rv32zicsr_sample(int hart, int issue);
    ins_rv32zicsr_t ins;
    // $display("inst=%s",traceDataQ[hart][issue][0].disass);

    case (traceDataQ[hart][issue][0].inst_name)

        "csrrc"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_csr(1);
            ins.add_rs1(2);
            rv32zicsr_csrrc_cg.sample(ins); 
        end

        "csrrci"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_csr(1);
            ins.add_imm(2);
            rv32zicsr_csrrci_cg.sample(ins); 
        end

        "csrrs"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_csr(1);
            ins.add_rs1(2);
            rv32zicsr_csrrs_cg.sample(ins); 
        end

        "csrrsi"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_csr(1);
            ins.add_imm(2);
            rv32zicsr_csrrsi_cg.sample(ins); 
        end

        "csrrw"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_csr(1);
            ins.add_rs1(2);
            rv32zicsr_csrrw_cg.sample(ins); 
        end

        "csrrwi"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_csr(1);
            ins.add_imm(2);
            rv32zicsr_csrrwi_cg.sample(ins); 
        end
    endcase
endfunction

function void rv32zicsr_sample_csrs(int compare, int index, int mask, int value, int hart, int issue);
endfunction


