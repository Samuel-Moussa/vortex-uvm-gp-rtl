    }
    cp_rs1_sign : coverpoint int32_t'(ins.current.rs1_val)  iff (ins.trap == 0 )  {
        option.comment = "Check if register value is pos/neg/zero";
        bins neg  = {[$:-1]};
        bins pos  = {[1:$]};
        bins zero = {0};
    }
    cp_rs2_sign : coverpoint int32_t'(ins.current.rs2_val)  iff (ins.trap == 0 )  {
        option.comment = "Check if register value is pos/neg/zero";
        bins neg  = {[$:-1]};
        bins pos  = {[1:$]};
        bins zero = {0};
    }
`endif  // COVER_TYPE_REG_VALUE_SIGN

`ifdef COVER_TYPE_REG_VALUE
    cp_rd_value : coverpoint uint32_t'(ins.current.rd_val)  iff (ins.trap == 0 )  {
        option.comment = "Check significant values for each register";
        bins zeros = {0};
        bins min   = {32'b10000000000000000000000000000000};
        bins max   = {32'b01111111111111111111111111111111};
        bins ones  = {32'b11111111111111111111111111111111};
        bins one   = {32'b00000000000000000000000000000001};
        bins minp1 = {32'b10000000000000000000000000000001};
    }
    cp_rs1_value : coverpoint uint32_t'(ins.current.rs1_val)  iff (ins.trap == 0 )  {
        option.comment = "Check significant values for each register";
        bins zeros = {0};
        bins min   = {32'b10000000000000000000000000000000};
        bins max   = {32'b01111111111111111111111111111111};
        bins ones  = {32'b11111111111111111111111111111111};
        bins one   = {32'b00000000000000000000000000000001};
        bins minp1 = {32'b10000000000000000000000000000001};
    }
    cp_rs2_value : coverpoint uint32_t'(ins.current.rs2_val)  iff (ins.trap == 0 )  {
        option.comment = "Check significant values for each register";
        bins zeros = {0};
        bins min   = {32'b10000000000000000000000000000000};
        bins max   = {32'b01111111111111111111111111111111};
        bins ones  = {32'b11111111111111111111111111111111};
        bins one   = {32'b00000000000000000000000000000001};
        bins minp1 = {32'b10000000000000000000000000000001};
    }
`endif  // COVER_TYPE_REG_VALUE

`ifdef COVER_TYPE_INSTR_DIVIDE
    cp_divide_by_zero : coverpoint {ins.current.rs2_val == 0,
                       int32_t'(ins.current.rs1_val) == 32'sh80000000
                       && int32_t'(ins.current.rs2_val) == -1}  iff (ins.trap == 0 )  {
        option.comment = "Check for divide-by-zero and over/underflow";
        bins normal      = {2'b00};
        bins overflow    = {2'b01};
        bins div_by_zero = {2'b10};
    }
`endif  // COVER_TYPE_INSTR_DIVIDE

`ifdef COVER_TYPE_REG_VALUE_TOGGLE
    cp_rd_toggle : coverpoint uint32_t'(ins.current.rd_val)  iff (ins.trap == 0 )  {
        option.comment = "Check for each bit toggling in each register";
        `RV32_BIT_TOGGLE_VALS
    }
    cp_rs1_toggle : coverpoint uint32_t'(ins.current.rs1_val)  iff (ins.trap == 0 )  {
        option.comment = "Check for each bit toggling in each register";
        `RV32_BIT_TOGGLE_VALS
    }
    cp_rs2_toggle : coverpoint uint32_t'(ins.current.rs2_val)  iff (ins.trap == 0 )  {
        option.comment = "Check for each bit toggling in each register";
        `RV32_BIT_TOGGLE_VALS
    }
`endif  // COVER_TYPE_REG_VALUE_TOGGLE

`ifdef COVER_TYPE_REG_HAZARD
    cp_reg_hazards : coverpoint check_gpr_hazards(ins.hart, ins.issue)  iff (ins.trap == 0 )  {
        option.comment = "Check for possible register hazards";
    }
`endif  // COVER_TYPE_REG_HAZARD

`endif  // !COVER_ILLEGAL_INST_REMU
endgroup


function void rv32m_sample(int hart, int issue);
    ins_rv32m_t ins;
    // $display("inst=%s",traceDataQ[hart][issue][0].disass);

    case (traceDataQ[hart][issue][0].inst_name)

        "div"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_rs1(1);
            ins.add_rs2(2);
            rv32m_div_cg.sample(ins); 
        end

        "divu"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_rs1(1);
            ins.add_rs2(2);
            rv32m_divu_cg.sample(ins); 
        end

        "mul"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_rs1(1);
            ins.add_rs2(2);
            rv32m_mul_cg.sample(ins); 
        end

        "mulh"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_rs1(1);
            ins.add_rs2(2);
            rv32m_mulh_cg.sample(ins); 
        end

        "mulhsu"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_rs1(1);
            ins.add_rs2(2);
            rv32m_mulhsu_cg.sample(ins); 
        end

        "mulhu"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_rs1(1);
            ins.add_rs2(2);
            rv32m_mulhu_cg.sample(ins); 
        end

        "rem"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_rs1(1);
            ins.add_rs2(2);
            rv32m_rem_cg.sample(ins); 
        end

        "remu"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_rs1(1);
            ins.add_rs2(2);
            rv32m_remu_cg.sample(ins); 
        end
    endcase
endfunction

function void rv32m_sample_csrs(int compare, int index, int mask, int value, int hart, int issue);
endfunction


