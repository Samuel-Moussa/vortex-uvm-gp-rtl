typedef RISCV_instruction #(ILEN, XLEN, FLEN, VLEN, NHART, RETIRE) ins_rv32zifencei_t;


covergroup rv32zifencei_fence_i_cg with function sample(ins_rv32zifencei_t ins);
    option.per_instance = 1; 
    option.comment = "Fence Instruction Stream";
`ifdef COVER_ILLEGAL_INST_FENCE.I
    cp_illegal_inst : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_AFTER, "mcause", "") == `MCAUSE_ILLEGAL_INST  iff (ins.trap == 1 )  {
        option.comment = "If instruction is not implemented in this configuration, check that exception is being hit";
    }
`else
`ifdef COVER_TYPE_ASM_COUNT
    cp_asm_count : coverpoint ins.ins_str == "fence.i"  iff (ins.trap == 0 )  {
        option.comment = "Number of times instruction executed";
        bins count[]  = {1};
    }
`endif  // COVER_TYPE_ASM_COUNT

`endif  // !COVER_ILLEGAL_INST_FENCE.I
endgroup


function void rv32zifencei_sample(int hart, int issue);
    ins_rv32zifencei_t ins;
    // $display("inst=%s",traceDataQ[hart][issue][0].disass);

    case (traceDataQ[hart][issue][0].inst_name)

        "fence.i"     : begin 
            ins = new(hart, issue, traceDataQ); 

            rv32zifencei_fence_i_cg.sample(ins); 
        end
    endcase
endfunction

function void rv32zifencei_sample_csrs(int compare, int index, int mask, int value, int hart, int issue);
endfunction


