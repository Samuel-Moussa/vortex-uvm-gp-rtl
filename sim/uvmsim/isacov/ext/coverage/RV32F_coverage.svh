        bins neg_min_sub = {32'h80000001};
        bins pos_max_sub = {32'h007FFFFF};
        bins pos_min_nrm = {32'h00800000};
        bins pos_max_nrm = {32'h7F7FFFFF};
        bins neg_max_nrm = {32'hFF7FFFFF};
        bins qnan        = {[32'h7FC00000 : 32'h7FFFFFFF]};
        bins snan        = {[32'h7F800001 : 32'h7FBFFFFF]};
        bins pos_other   = default;
    }
`endif  // COVER_TYPE_REG_FPVALUE

`ifdef COVER_TYPE_MEM_ALIGNED
    cp_mem_aligned : coverpoint is_unaligned_mem_access(ins.hart, ins.issue)  {
        option.comment = "For load/store, check if memory is aligned";
    }
`endif  // COVER_TYPE_MEM_ALIGNED

`ifdef COVER_TYPE_REG_HAZARD
    cp_reg_hazards : coverpoint check_gpr_hazards(ins.hart, ins.issue)  iff (ins.trap == 0 )  {
        option.comment = "Check for possible register hazards";
    }
    cp_freg_hazards : coverpoint check_fpr_hazards(ins.hart, ins.issue)  iff (ins.trap == 0 )  {
        option.comment = "Check for possible register hazards";
    }
`endif  // COVER_TYPE_REG_HAZARD

`endif  // !COVER_ILLEGAL_INST_FSW
endgroup


function void rv32f_sample(int hart, int issue);
    ins_rv32f_t ins;
    // $display("inst=%s",traceDataQ[hart][issue][0].disass);

    case (traceDataQ[hart][issue][0].inst_name)

        "fadd.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            ins.add_fp_rm(3);
            rv32f_fadd_s_cg.sample(ins); 
        end

        "fclass.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_fs1(1);
            rv32f_fclass_s_cg.sample(ins); 
        end

        "fcvt.s.w"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_rs1(1);
            ins.add_fp_rm(2);
            rv32f_fcvt_s_w_cg.sample(ins); 
        end

        "fcvt.s.wu"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_rs1(1);
            ins.add_fp_rm(2);
            rv32f_fcvt_s_wu_cg.sample(ins); 
        end

        "fcvt.w.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_fs1(1);
            ins.add_fp_rm(2);
            rv32f_fcvt_w_s_cg.sample(ins); 
        end

        "fcvt.wu.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_fs1(1);
            ins.add_fp_rm(2);
            rv32f_fcvt_wu_s_cg.sample(ins); 
        end

        "fdiv.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            ins.add_fp_rm(3);
            rv32f_fdiv_s_cg.sample(ins); 
        end

        "feq.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            rv32f_feq_s_cg.sample(ins); 
        end

        "fle.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            rv32f_fle_s_cg.sample(ins); 
        end

        "flt.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            rv32f_flt_s_cg.sample(ins); 
        end

        "flw"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_imm(1);
            ins.add_rs1(2);
            ins.current.inst_category = INST_CAT_LOAD;
            ins.add_mem_address();
            rv32f_flw_cg.sample(ins); 
        end

        "fmadd.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            ins.add_fs3(3);
            ins.add_fp_rm(4);
            rv32f_fmadd_s_cg.sample(ins); 
        end

        "fmax.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            rv32f_fmax_s_cg.sample(ins); 
        end

        "fmin.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            rv32f_fmin_s_cg.sample(ins); 
        end

        "fmsub.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            ins.add_fs3(3);
            ins.add_fp_rm(4);
            rv32f_fmsub_s_cg.sample(ins); 
        end

        "fmul.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            ins.add_fp_rm(3);
            rv32f_fmul_s_cg.sample(ins); 
        end

        "fmv.w.x"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_rs1(1);
            rv32f_fmv_w_x_cg.sample(ins); 
        end

        "fmv.x.w"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_fs1(1);
            rv32f_fmv_x_w_cg.sample(ins); 
        end

        "fnmadd.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            ins.add_fs3(3);
            ins.add_fp_rm(4);
            rv32f_fnmadd_s_cg.sample(ins); 
        end

        "fnmsub.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            ins.add_fs3(3);
            ins.add_fp_rm(4);
            rv32f_fnmsub_s_cg.sample(ins); 
        end

        "fsgnj.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            rv32f_fsgnj_s_cg.sample(ins); 
        end

        "fsgnjn.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            rv32f_fsgnjn_s_cg.sample(ins); 
        end

        "fsgnjx.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            rv32f_fsgnjx_s_cg.sample(ins); 
        end

        "fsqrt.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_fs1(1);
            ins.add_fp_rm(2);
            rv32f_fsqrt_s_cg.sample(ins); 
        end

        "fsub.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            ins.add_fp_rm(3);
            rv32f_fsub_s_cg.sample(ins); 
        end

        "fsw"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fs2(0);
            ins.add_imm(1);
            ins.add_rs1(2);
            ins.current.inst_category = INST_CAT_STORE;
            ins.add_mem_address();
            rv32f_fsw_cg.sample(ins); 
        end
    endcase
endfunction

