`ifdef COVER_TYPE_REG_VALUE_SIGN
    cp_rs1_sign : coverpoint int32_t'(ins.current.rs1_val)  iff (ins.trap == 0 )  {
        option.comment = "Check if register value is pos/neg/zero";
        bins neg  = {[$:-1]};
        bins pos  = {[1:$]};
        bins zero = {0};
    }
`endif  // COVER_TYPE_REG_VALUE_SIGN

`ifdef COVER_TYPE_REG_VALUE
    cp_rs1_value : coverpoint uint32_t'(ins.current.rs1_val)  iff (ins.trap == 0 )  {
        option.comment = "Check significant values for each register";
        bins zeros = {0};
        bins min   = {32'b10000000000000000000000000000000};
        bins max   = {32'b01111111111111111111111111111111};
        bins ones  = {32'b11111111111111111111111111111111};
        bins one   = {32'b00000000000000000000000000000001};
        bins minp1 = {32'b10000000000000000000000000000001};
    }
`endif  // COVER_TYPE_REG_VALUE

