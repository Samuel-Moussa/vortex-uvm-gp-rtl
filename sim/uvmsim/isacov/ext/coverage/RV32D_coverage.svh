        bins UF   = {5'b00010};
        bins OF   = {5'b00100};
        bins DZ   = {5'b01000};
        bins NV   = {5'b10000};
        bins multi = default;
    }
`endif  // COVER_TYPE_FP_FFLAG

`endif  // !COVER_ILLEGAL_INST_FCVT.W.D
