        option.comment = "Check for possible register hazards";
    }
`endif  // COVER_TYPE_REG_HAZARD

`ifdef COVER_TYPE_FP_RM
    cp_rm : coverpoint get_frm(ins.current.fp_rm)  iff (ins.trap == 0 )  {
        option.comment = "Floating Point Rounding Mode";
    }
    cp_frm : coverpoint get_csr_frm(int'(get_csr_val(ins.hart, ins.issue, `SAMPLE_AFTER, "frm", "frm")))  iff (ins.trap == 0 )  {
        option.comment = "Floating Point Rounding Mode";
    }
    cr_rm_frm : cross cp_rm, cp_frm iff (ins.trap == 0 )  {
        option.comment = "Floating Point Rounding Mode";
    }
`endif  // COVER_TYPE_FP_RM

`ifdef COVER_TYPE_FP_FFLAG
