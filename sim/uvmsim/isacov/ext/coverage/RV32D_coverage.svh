        bins neg_min_sub = {32'h80000001};
        bins pos_max_sub = {32'h007FFFFF};
        bins pos_min_nrm = {32'h00800000};
        bins pos_max_nrm = {32'h7F7FFFFF};
        bins neg_max_nrm = {32'hFF7FFFFF};
        bins qnan        = {[32'h7FC00000 : 32'h7FFFFFFF]};
        bins snan        = {[32'h7F800001 : 32'h7FBFFFFF]};
        bins pos_other   = default;
    }
