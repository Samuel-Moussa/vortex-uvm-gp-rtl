function void rv32d_sample(int hart, int issue);
    ins_rv32d_t ins;
    // $display("inst=%s",traceDataQ[hart][issue][0].disass);

    case (traceDataQ[hart][issue][0].inst_name)

        "fadd.d"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            ins.add_fp_rm(3);
            rv32d_fadd_d_cg.sample(ins); 
        end

        "fclass.d"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_fs1(1);
            rv32d_fclass_d_cg.sample(ins); 
        end

        "fcvt.d.l"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_rs1(1);
            ins.add_fp_rm(2);
            rv32d_fcvt_d_l_cg.sample(ins); 
        end

        "fcvt.d.lu"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_rs1(1);
            ins.add_fp_rm(2);
            rv32d_fcvt_d_lu_cg.sample(ins); 
        end

        "fcvt.d.s"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_fs1(1);
            ins.add_fp_rm(2);
            rv32d_fcvt_d_s_cg.sample(ins); 
        end

        "fcvt.d.w"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_rs1(1);
            ins.add_fp_rm(2);
            rv32d_fcvt_d_w_cg.sample(ins); 
        end

        "fcvt.d.wu"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_rs1(1);
            ins.add_fp_rm(2);
            rv32d_fcvt_d_wu_cg.sample(ins); 
        end

        "fcvt.l.d"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_fs1(1);
            ins.add_fp_rm(2);
            rv32d_fcvt_l_d_cg.sample(ins); 
        end

        "fcvt.lu.d"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_fs1(1);
            ins.add_fp_rm(2);
            rv32d_fcvt_lu_d_cg.sample(ins); 
        end

        "fcvt.s.d"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_fs1(1);
            ins.add_fp_rm(2);
            rv32d_fcvt_s_d_cg.sample(ins); 
        end

        "fcvt.w.d"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_fs1(1);
            ins.add_fp_rm(2);
            rv32d_fcvt_w_d_cg.sample(ins); 
        end

        "fcvt.wu.d"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_fs1(1);
            ins.add_fp_rm(2);
            rv32d_fcvt_wu_d_cg.sample(ins); 
        end

        "fdiv.d"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            ins.add_fp_rm(3);
            rv32d_fdiv_d_cg.sample(ins); 
        end

        "feq.d"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_rd(0);
            ins.add_fs1(1);
            ins.add_fs2(2);
            rv32d_feq_d_cg.sample(ins); 
        end

        "fld"     : begin 
            ins = new(hart, issue, traceDataQ); 

            ins.add_fd(0);
            ins.add_imm(1);
            ins.add_rs1(2);
