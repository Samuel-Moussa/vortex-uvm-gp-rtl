covergroup rv32d_fadd_d_cg with function sample(ins_rv32d_t ins);
    option.per_instance = 1; 
    option.comment = "Floating-point Add Double";
`ifdef COVER_ILLEGAL_INST_FADD.D
    cp_illegal_inst : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_AFTER, "mcause", "") == `MCAUSE_ILLEGAL_INST  iff (ins.trap == 1 )  {
        option.comment = "If instruction is not implemented in this configuration, check that exception is being hit";
    }
`else
`ifdef COVER_TYPE_ASM_COUNT
    cp_asm_count : coverpoint ins.ins_str == "fadd.d"  iff (ins.trap == 0 )  {
        option.comment = "Number of times instruction executed";
        bins count[]  = {1};
    }
`endif  // COVER_TYPE_ASM_COUNT

`ifdef COVER_TYPE_REG_ASSIGN
    cp_fd_reg_assign : coverpoint ins.get_fpr_reg(ins.current.fd)  iff (ins.trap == 0 )  {
        option.comment = "All legal register assignments";
    }
    cp_fs1_reg_assign : coverpoint ins.get_fpr_reg(ins.current.fs1)  iff (ins.trap == 0 )  {
        option.comment = "All legal register assignments";
    }
    cp_fs2_reg_assign : coverpoint ins.get_fpr_reg(ins.current.fs2)  iff (ins.trap == 0 )  {
        option.comment = "All legal register assignments";
    }
`endif  // COVER_TYPE_REG_ASSIGN

`ifdef COVER_TYPE_REG_FPVALUE
    cp_fd_value : coverpoint uint32_t'(ins.current.fd_val)  iff (ins.trap == 0 )  {
        option.comment = "Check for significant floating-point values for each register";
        bins pos_zero    = {32'h00000000};
        bins neg_zero    = {32'h80000000};
        bins pos_one     = {32'h3F800000};
        bins neg_one     = {32'hBF800000};
        bins pos_inf     = {32'h7F800000};
        bins neg_inf     = {32'hFF800000};
        bins pos_min_sub = {32'h00000001};
        bins neg_min_sub = {32'h80000001};
        bins pos_max_sub = {32'h007FFFFF};
        bins pos_min_nrm = {32'h00800000};
        bins pos_max_nrm = {32'h7F7FFFFF};
        bins neg_max_nrm = {32'hFF7FFFFF};
        bins qnan        = {[32'h7FC00000 : 32'h7FFFFFFF]};
        bins snan        = {[32'h7F800001 : 32'h7FBFFFFF]};
        bins pos_other   = default;
    }
    cp_fs1_value : coverpoint uint32_t'(ins.current.fs1_val)  iff (ins.trap == 0 )  {
