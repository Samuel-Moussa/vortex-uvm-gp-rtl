        bins pos_zero    = {32'h00000000};
        bins neg_zero    = {32'h80000000};
        bins pos_one     = {32'h3F800000};
        bins neg_one     = {32'hBF800000};
        bins pos_inf     = {32'h7F800000};
        bins neg_inf     = {32'hFF800000};
        bins pos_min_sub = {32'h00000001};
