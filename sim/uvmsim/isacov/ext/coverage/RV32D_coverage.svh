covergroup rv32d_fsd_cg with function sample(ins_rv32d_t ins);
    option.per_instance = 1; 
    option.comment = "Floating-point Store Double";
`ifdef COVER_ILLEGAL_INST_FSD
    cp_illegal_inst : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_AFTER, "mcause", "") == `MCAUSE_ILLEGAL_INST  iff (ins.trap == 1 )  {
        option.comment = "If instruction is not implemented in this configuration, check that exception is being hit";
    }
`else
`ifdef COVER_TYPE_ASM_COUNT
    cp_asm_count : coverpoint ins.ins_str == "fsd"  iff (ins.trap == 0 )  {
        option.comment = "Number of times instruction executed";
        bins count[]  = {1};
    }
`endif  // COVER_TYPE_ASM_COUNT

`ifdef COVER_TYPE_REG_ASSIGN
    cp_fs2_reg_assign : coverpoint ins.get_fpr_reg(ins.current.fs2)  iff (ins.trap == 0 )  {
        option.comment = "All legal register assignments";
    }
    cp_rs1_reg_assign : coverpoint ins.get_gpr_reg(ins.current.rs1)  iff (ins.trap == 0 )  {
        option.comment = "All legal register assignments";
    }
`endif  // COVER_TYPE_REG_ASSIGN

`ifdef COVER_TYPE_IMM_VALUE
    cp_imm_value : coverpoint int'(ins.current.imm)  iff (ins.trap == 0 )  {
        option.comment = "Check values for immediate";
        bins neg  = {[$:-1]};
        bins pos  = {[1:$]};
        bins zero = {0};
    }
`endif  // COVER_TYPE_IMM_VALUE

`ifdef COVER_TYPE_REG_VALUE
    cp_rs1_value : coverpoint uint32_t'(ins.current.rs1_val)  iff (ins.trap == 0 )  {
        option.comment = "Check significant values for each register";
        bins zeros = {0};
        bins min   = {32'b10000000000000000000000000000000};
        bins max   = {32'b01111111111111111111111111111111};
        bins ones  = {32'b11111111111111111111111111111111};
        bins one   = {32'b00000000000000000000000000000001};
        bins minp1 = {32'b10000000000000000000000000000001};
    }
`endif  // COVER_TYPE_REG_VALUE

`ifdef COVER_TYPE_REG_FPVALUE
    cp_fs2_value : coverpoint uint32_t'(ins.current.fs2_val)  iff (ins.trap == 0 )  {
        option.comment = "Check for significant floating-point values for each register";
        bins pos_zero    = {32'h00000000};
        bins neg_zero    = {32'h80000000};
        bins pos_one     = {32'h3F800000};
        bins neg_one     = {32'hBF800000};
        bins pos_inf     = {32'h7F800000};
        bins neg_inf     = {32'hFF800000};
        bins pos_min_sub = {32'h00000001};
        bins neg_min_sub = {32'h80000001};
        bins pos_max_sub = {32'h007FFFFF};
        bins pos_min_nrm = {32'h00800000};
        bins pos_max_nrm = {32'h7F7FFFFF};
        bins neg_max_nrm = {32'hFF7FFFFF};
        bins qnan        = {[32'h7FC00000 : 32'h7FFFFFFF]};
        bins snan        = {[32'h7F800001 : 32'h7FBFFFFF]};
        bins pos_other   = default;
    }
`endif  // COVER_TYPE_REG_FPVALUE

`ifdef COVER_TYPE_MEM_ALIGNED
    cp_mem_aligned : coverpoint is_unaligned_mem_access(ins.hart, ins.issue)  {
        option.comment = "For load/store, check if memory is aligned";
    }
`endif  // COVER_TYPE_MEM_ALIGNED

`ifdef COVER_TYPE_REG_HAZARD
    cp_reg_hazards : coverpoint check_gpr_hazards(ins.hart, ins.issue)  iff (ins.trap == 0 )  {
        option.comment = "Check for possible register hazards";
    }
    cp_freg_hazards : coverpoint check_fpr_hazards(ins.hart, ins.issue)  iff (ins.trap == 0 )  {
        option.comment = "Check for possible register hazards";
    }
`endif  // COVER_TYPE_REG_HAZARD

`endif  // !COVER_ILLEGAL_INST_FSD
endgroup

